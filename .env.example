# Copy to .env and fill in. Never commit .env.
# Values come from Meta for Developers > your app > WhatsApp > API Setup.

# Permanent system-user token (Business Settings > System users) with
# whatsapp_business_messaging + whatsapp_business_management permissions.
WHATSAPP_TOKEN=

# "Phone number ID" (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# "WhatsApp Business Account ID", needed for templates.
WHATSAPP_WABA_ID=

# Graph API version.
WHATSAPP_API_VERSION=v23.0

# Webhook: any random string you also paste into the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=

# App secret (App settings > Basic), used to verify webhook signatures.
WHATSAPP_APP_SECRET=

# GitHub MCP server (.mcp.json). Fine-grained PAT from
# github.com/settings/personal-access-tokens. Export it in your shell
# before starting Claude Code; .mcp.json reads it from the environment.
GITHUB_PERSONAL_ACCESS_TOKEN=
